{
  "name": "@haneoka/vega-preset-full",
  "version": "0.1.0",
  "description": "Batteries-included official plugin preset for Vega",
  "keywords": [
    "visual-novel",
    "game-engine",
    "preset",
    "vega"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/vega-preset-full.git"
  },
  "homepage": "https://github.com/haneoka-gakuen/vega-preset-full#readme",
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/vega-preset-full/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package",
    "prepack": "pnpm run check"
  },
  "dependencies": {
    "@haneoka/vega-plugin-ending": "workspace:*",
    "@haneoka/vega-plugin-cubism": "workspace:*",
    "@haneoka/vega-plugin-richtext": "workspace:*",
    "@haneoka/vega-plugin-richtext-bbcode": "workspace:*",
    "@haneoka/vega-plugin-richtext-html": "workspace:*",
    "@haneoka/vega-plugin-richtext-latex": "workspace:*",
    "@haneoka/vega-plugin-richtext-markdown": "workspace:*",
    "@haneoka/vega-plugin-richtext-typst": "workspace:*",
    "@haneoka/vega-plugin-spine": "workspace:*",
    "@haneoka/vega-plugin-webgal": "workspace:*",
    "@haneoka/vega-renderer-pixi": "workspace:*",
    "@haneoka/vega-renderer-three": "workspace:*",
    "@haneoka/vega-shell-default": "workspace:*",
    "@haneoka/vega-theme-haneoka": "workspace:*",
    "@haneoka/vega-ui-portable": "workspace:*"
  },
  "peerDependencies": {
    "@haneoka/vega": "^0.1.0",
    "pixi.js": ">=6.3.0 <7",
    "three": ">=0.184.0 <0.185.0"
  },
  "devDependencies": {
    "@haneoka/vega": "workspace:*",
    "pixi.js": "6.5.10",
    "three": "0.184.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "vega": {
    "pluginApi": 1,
    "kind": "preset",
    "capabilities": [],
    "permissions": [],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  }
}
